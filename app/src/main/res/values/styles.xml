<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme for the app window. Compose handles all visual styling;
        this just sets the window chrome and suppresses the action bar.
    -->
    <style name="Theme.StunMap" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0A0E1A</item>
        <item name="android:navigationBarColor">#0A0E1A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
